# Sentry DSN baked into debug and release builds. An empty value disables reporting.
SENTRY_DSN=

# Host and user of the Linux test virtual machine, used by `just deploy-linux`,
# `just linux-ssh` and `just linux-fetch`.
LINUX_HOST=ubuntu2204-test.tail712f59.ts.net
LINUX_USER=user

# Keystore of the Android release APK, used by `just release-android`. Without
# it the APK stays unsigned. A relative path is resolved against the repository root.
UNISON_ANDROID_KEYSTORE=
UNISON_ANDROID_STORE_PASSWORD=
UNISON_ANDROID_KEY_ALIAS=
UNISON_ANDROID_KEY_PASSWORD=
