# Sentry DSN baked into debug and release builds. An empty value disables reporting.
SENTRY_DSN=

# Host and user of the Linux test virtual machine, used by `just deploy-linux`,
# `just linux-ssh` and `just linux-fetch`.
LINUX_HOST=ubuntu2204-test.tail712f59.ts.net
LINUX_USER=user

# Keystore of the Android release APK, required by `just release-android`.
# A relative path is resolved against the repository root.
UNISON_ANDROID_KEYSTORE=
UNISON_ANDROID_STORE_PASSWORD=
UNISON_ANDROID_KEY_ALIAS=
UNISON_ANDROID_KEY_PASSWORD=

# Ed25519 key that signs the update manifests. Empty uses
# packaging/release-public-key.txt.
UNISON_UPDATE_PUBLIC_KEY=

# Codesigning identity for the macOS app and disk image, ad-hoc when empty.
UNISON_MACOS_SIGN_IDENTITY=
