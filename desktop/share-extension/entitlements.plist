<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- An app extension must run in the sandbox. It only opens the shared files
       with the app of the bundle, so it needs no other entitlement. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
</dict>
</plist>
