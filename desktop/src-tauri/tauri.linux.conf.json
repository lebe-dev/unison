{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Unison",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "targets": ["deb"],
    "publisher": "Unison",
    "shortDescription": "Clipboard and file sharing between devices",
    "longDescription": "Unison shares the clipboard between the devices of one person and keeps the history of what was copied.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/unisond"],
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/bin/unison": "binaries/unison-x86_64-unknown-linux-gnu",
          "/usr/lib/systemd/user/unisond.service": "../../packaging/linux/systemd/unisond.service"
        }
      }
    }
  }
}
