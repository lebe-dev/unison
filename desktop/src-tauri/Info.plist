<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>ru</string>
  </array>
  <!-- The share extension opens the shared files with the app, and Launch
       Services refuses to open a file with an app that claims no type for it.
       The rank None keeps Unison out of the default and Open With choices. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>File</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>None</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.data</string>
      </array>
    </dict>
  </array>
  <!-- The daemon of the bundle discovers and serves the paired devices. -->
  <key>NSBonjourServices</key>
  <array>
    <string>_unison._udp</string>
    <string>_unison-pair._udp</string>
    <string>_unison-friends._udp</string>
  </array>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Unison finds your other devices on the local network and exchanges clipboard items and files with them.</string>
</dict>
</plist>
