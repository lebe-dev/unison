{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the prompt window",
  "windows": ["main", "prompt"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
